PROJECT_NAME="WeGrow ERP & Admin Portal"
API_V1_STR="/api"
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Connection (Default local port 5432)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wegrow_erp_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wegrow_erp_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# WhatsApp API Configuration
WHATSAPP_API_URL="https://api.whatsapp.com/v1/messages"
WHATSAPP_API_KEY="your_api_key_here"
WHATSAPP_SENDER_NUMBER="919876543210"
